; =============================================================================
; PROYECTO  : PinturaPittsburgh_LaPazBCS
; ARCHIVO   : .env.example  (Plantilla Pública — instanciado desde AXON_DCD v2)
; USO       : Copiar este archivo como .env en local y servidor. NUNCA subir .env real a GitHub.
; =============================================================================

; ── ENTORNO ──────────────────────────────────────────────────────────────────
APP_ENV = "local"            ; Valores: local | staging | production
APP_URL = "http://localhost/PinturaPittsburgh_LaPazBCS"
APP_DEBUG = "true"           ; Cambiar a false en producción

; ── BASE DE DATOS ─────────────────────────────────────────────────────────────
; REGLA CERO (Aislamiento de Entornos): la BD NUNCA es local, ni en desarrollo.
; El frontend/backend corre en localhost, pero DB_HOST SIEMPRE apunta al
; servidor remoto centralizado. Jamás usar "localhost" o "127.0.0.1" aquí.
; Jamás reutilizar el host remoto de un proyecto ajeno (ver hallazgo core/.env
; eliminado el 2026-09-11 — pertenecía al proyecto tourfindy.com/GreenGeeks).
DB_HOST = "[HOST_BD_REMOTO_DEL_HOSTING — pendiente de contratar hosting]"
DB_NAME = "pinturapittsburgh_lapaz"
DB_USER = "pinturapittsburgh_app"
DB_PASS = "contrasena_bd"

; ── SEGURIDAD Y AUTENTICACIÓN ─────────────────────────────────────────────────
; JWT_SECRET: Mínimo 64 caracteres aleatorios. Generar con: openssl rand -base64 64
; o con scripts/generate_jwt_keys.php
JWT_SECRET       = "REEMPLAZAR_CON_STRING_LARGO_Y_ALEATORIO_MINIMO_64_CHARS"
JWT_ACCESS_TTL   = "900"     ; Access token: 15 minutos
JWT_REFRESH_TTL  = "2592000" ; Refresh token: 30 días
JWT_TTL          = "3600"    ; Legado — TTL genérico para jwtEncode()/jwtDecode() sin tipar

; Orígenes permitidos (CORS) — separados por coma, sin espacios
ALLOWED_ORIGINS = "https://[dominio-pinturapittsburgh-lapaz-pendiente].com,http://localhost"
FRONTEND_URL    = "https://[dominio-pinturapittsburgh-lapaz-pendiente].com"

; ── COBERTURA TERRITORIAL (Regla de Marca — venta restringida a La Paz, B.C.S.) ─
; La lista completa de los 104 códigos postales vive en la tabla
; `codigos_postales_cobertura` (ver knowledge/02_CODEX_Y_SCHEMA_MAESTRO.md).
; No se hardcodea aquí ninguna lista — este flag solo activa/desactiva la
; validación de checkout en runtime.
POSTAL_VALIDATION_ENABLED = "true"

; ── API KEYS Y SERVICIOS EXTERNOS ─────────────────────────────────────────────
; Pasarela de pagos (descomenta la que uses)
PAYPAL_CLIENT_ID     = "tu_client_id_aqui"
PAYPAL_SECRET        = "tu_secret_aqui"
PAYPAL_MODE          = "sandbox"    ; sandbox | live
; STRIPE_SECRET_KEY  = "sk_test_aqui"
; STRIPE_PUBLIC_KEY  = "pk_test_aqui"

; IA — Asistente de contenido interno (redacción, SEO, recomendaciones técnicas).
; Uso exclusivamente interno/administrativo. Nunca se expone a clientes externos.
; ANTHROPIC_API_KEY  = "sk-ant-..."
; OPENAI_API_KEY     = "sk-..."
; AI_MODEL           = "gpt-4o-mini"

; ── META GRAPH API (Publicador Social Facebook/Instagram) ────────────────────
; Los tokens de página/cuenta NUNCA se guardan en texto plano en BD — se
; almacenan cifrados con Envelope Encryption AES-256-GCM (ver
; knowledge/04_ARQUITECTURA_Y_BLINDAJE.md). Aquí solo vive la KEK (Key
; Encryption Key) maestra, nunca las DEK ni los tokens.
; META_APP_ID         = "tu_app_id"
; META_APP_SECRET     = "tu_app_secret"
; META_TOKEN_KEK       = "REEMPLAZAR_CON_CLAVE_MAESTRA_256_BITS_BASE64"
; META_GRAPH_API_VERSION = "v25.0"

; ── CORREO (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST     = "smtp.[dominio-pinturapittsburgh-lapaz-pendiente].com"
SMTP_PORT     = "587"
SMTP_SECURE   = "tls"        ; tls | ssl
SMTP_USER     = "contacto@[dominio-pinturapittsburgh-lapaz-pendiente].com"
SMTP_PASS     = "tu_password_smtp"
MAIL_FROM_NAME = "PinturaPittsburgh - Distribuidor Autorizado La Paz"

; ── ALMACENAMIENTO (S3 / Compatible) ──────────────────────────────────────────
; AWS_ACCESS_KEY_ID     = "tu_access_key"
; AWS_SECRET_ACCESS_KEY = "tu_secret_key"
; AWS_BUCKET            = "nombre-del-bucket"
; AWS_REGION            = "us-east-1"

; ── CI/CD (SOLO usar como GitHub Secrets — no escribir valores reales aquí) ───
; FTP_SERVER     = "ftp.[dominio-pinturapittsburgh-lapaz-pendiente].com"
; FTP_USERNAME   = "usuario_ftp"
; FTP_PASSWORD   = "password_ftp"
; FTP_REMOTE_DIR = "/public_html/"
